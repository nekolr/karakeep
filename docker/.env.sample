# See https://docs.karakeep.com/configuration for more information
DATA_DIR=/data
MEILI_ADDR=http://127.0.0.1:7700
MEILI_MASTER_KEY=[generate with <openssl rand -base64 36 | tr -dc 'A-Za-z0-9'>]
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=[generate with <openssl rand -base64 36>]
# Optional: tag used for the local Karakeep web image build
KARAKEEP_WEB_TAG=local
# Optional: mirrors used while building the Karakeep web image
DEBIAN_APT_MIRROR=http://mirrors.aliyun.com/debian
DEBIAN_SECURITY_APT_MIRROR=http://mirrors.aliyun.com/debian-security
NPM_REGISTRY=https://registry.npmmirror.com/
CARGO_REGISTRIES_CRATES_IO_INDEX=https://rsproxy.cn/crates.io-index
CARGO_REGISTRIES_CRATES_IO_PROTOCOL=sparse
# Optional: tag used for the local Ubuntu desktop Chrome image build
KARAKEEP_CHROME_TAG=local
# Optional: Google Chrome version used by the desktop image
GOOGLE_CHROME_VERSION=157.0.8103.38
# Optional: Docker registry image used as the Ubuntu base
# UBUNTU_IMAGE=docker.1ms.run/library/ubuntu:24.04
# Optional: URL of a cached Chrome Debian package
# CHROME_DOWNLOAD_URL=http://host.docker.internal:8000/google-chrome.deb
# Optional: proxy used only while downloading the Chrome package during build
# CHROME_DOWNLOAD_PROXY=http://host.docker.internal:7890
# Optional: Ubuntu apt mirror used while building the desktop Chrome image
UBUNTU_APT_MIRROR=http://mirrors.aliyun.com/ubuntu/
# Optional: publish the desktop browser locally
KARAKEEP_CHROME_DESKTOP_PORT=127.0.0.1:6080:6080
KARAKEEP_CHROME_DEBUG_PORT=127.0.0.1:9222:9222


# Optional: proxy settings for the desktop Chrome container
# CHROME_PROXY_SERVER=http://proxy.example.com:7890
# CHROME_PROXY_BYPASS_LIST=localhost;127.0.0.1;chrome;meilisearch
# CHROME_PROXY_PAC_URL=http://proxy.example.com/proxy.pac

# Optional: fallback for environments where Chrome sandboxing fails
# CHROME_DISABLE_SANDBOX=true

# Optional: additional Chrome command-line arguments
# CHROME_EXTRA_ARGS=--lang=zh-CN

# Optional: wait for bot-protection challenges to clear
# CRAWLER_CHALLENGE_WAIT_SEC=30
# Optional: keep the browser timezone aligned with the proxy exit location
# CRAWLER_BROWSER_TIMEZONE=Asia/Shanghai
# Optional: leave enough time for navigation and challenge handling
# CRAWLER_JOB_TIMEOUT_SEC=120
